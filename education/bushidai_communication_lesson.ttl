@prefix bushidai: <https://raw.githubusercontent.com/Thizz87/bushidai-truth-engine/main/ontology#> .
@prefix uvrm:    <https://un.org/udhr#> .
@prefix evrm:    <https://echr.coe.int#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

<https://raw.githubusercontent.com/Thizz87/bushidai-truth-engine/main/lesson#communicationLesson>
    a bushidai:CommunicationLesson ;
    bushidai:name "Gouden Combo xAI + BushiDAI + Humanity — Geo Governance WAS" .

# === PUNT 1 ===
<https://raw.githubusercontent.com/Thizz87/bushidai-truth-engine/main/lesson#lessonPoint1>
    a bushidai:LessonPoint ;
    bushidai:belongsTo <https://raw.githubusercontent.com/Thizz87/bushidai-truth-engine/main/lesson#communicationLesson> ;
    bushidai:pointNumber "1"^^xsd:string ;
    bushidai:description "Framing / semantiek" ;
    bushidai:knowledgeBase "Framing en taal als machtsinstrument in communicatie (historisch en modern)" ;
    bushidai:problemDefinition "Pavlov semantiek / state education gebruikt in Platform Overheid taal-spel om perceptie te manipuleren" ;
    bushidai:counterSolution "Karate / Sanchin als embodied alternatief voor digitale framing" ;
    bushidai:embodiedAlternative "Karate / Sanchin" ;
    bushidai:concreteExample "Gemini 25 mei 2026 semantische manipulatie + volledige geo-governance keten: Bilderberg → WEF → DMA Gatekeepers + Azure" ;
    bushidai:selfProtectClause "UVRM Art 30 / EVRM Art 17" ;
    bushidai:riskLevel "High Ruis & Intentie-Verlies" ;
    bushidai:goldenCombo "= Symbiose" .

